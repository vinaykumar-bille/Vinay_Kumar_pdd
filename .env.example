# =========================================================================
# AI-POWERED SMART DOCTOR APPOINTMENT & HEALTHCARE SYSTEM CONFIGURATION
# =========================================================================
# The system works immediately in Zero-Config Demo Mode if these are left blank.
# Fill these in to connect to production cloud database, auth, and AI.

# 1. Server & API Configuration
PORT=5000
API_BASE_URL=http://localhost:5000/api

# 2. Mobile App (Physical Device LAN URL)
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# 3. Database Configuration
# Leave empty to run in Zero-Config Demonstration Mode (In-memory high-fidelity store)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/healthcare

# 4. AI Healthcare Assistant (OpenAI Integration)
# Leave empty to run the built-in clinical NLP triage engine
OPENAI_API_KEY=your_openai_api_key_here

# 5. Supabase Configuration (Optional for cloud DB/auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# 6. Firebase Authentication (Optional)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
