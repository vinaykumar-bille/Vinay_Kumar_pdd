# Backend Server Configuration
PORT=5000

# AI Intelligence Microservice & Ollama Configuration
AI_SERVICE_URL=http://localhost:8000
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Optional Database: Leave blank to run in simulated High-Fidelity Demo Mode (In-memory store)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/healthcare

# Optional OpenAI API Key (Fallback local Ollama / clinical triage runs if blank)
OPENAI_API_KEY=your_openai_api_key_here

# Supabase Credentials (Optional for cloud DB/auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
